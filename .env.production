# Production Environment Configuration
# 生产环境配置

# IMPORTANT: Replace all placeholder values with actual production values
# 重要：将所有占位符值替换为实际的生产值

# Server Configuration / 服务器配置
NODE_ENV=production
PORT=4000

# Database Configuration / 数据库配置
DB_HOST=postgres
DB_PORT=5432
DB_NAME=english_learning
DB_USER=postgres
DB_PASSWORD=CHANGE_THIS_STRONG_PASSWORD_IN_PRODUCTION

# JWT Configuration / JWT 配置
# Generate a strong random secret: openssl rand -base64 32
# 生成强随机密钥：openssl rand -base64 32
JWT_SECRET=CHANGE_THIS_JWT_SECRET_IN_PRODUCTION
JWT_EXPIRES_IN=7d

# Google Translate API / Google 翻译 API
GOOGLE_TRANSLATE_API_KEY=YOUR_GOOGLE_TRANSLATE_API_KEY_HERE

# Image Service Configuration / 图像服务配置
IMAGE_API_KEY=YOUR_IMAGE_API_KEY_HERE
IMAGE_API_PROVIDER=unsplash

# Security / 安全配置
BCRYPT_SALT_ROUNDS=10

# API Timeouts (milliseconds) / API 超时（毫秒）
TRANSLATION_TIMEOUT=5000
IMAGE_TIMEOUT=5000
DB_QUERY_TIMEOUT=10000

# CORS Configuration (optional) / CORS 配置（可选）
# CORS_ORIGIN=https://yourdomain.com

# Rate Limiting (optional) / 速率限制（可选）
# RATE_LIMIT_WINDOW_MS=60000
# RATE_LIMIT_MAX_REQUESTS=60

# Logging / 日志配置
# LOG_LEVEL=info
# LOG_FILE_PATH=/var/log/app/app.log
